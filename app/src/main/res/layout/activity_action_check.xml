<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.data.ActionCheckActivity">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/act_periksa_toolbar"
        android:background="@drawable/bg_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="15dp">
            <ImageView
                android:id="@+id/iv_act_periksa_toolbar_back"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_baseline_arrow_back_24"
                android:layout_centerVertical="true"
                android:contentDescription="@string/photo"
                android:paddingEnd="24dp"
                tools:ignore="RtlSymmetry" />
            <TextView
                android:textSize="18sp"
                android:textColor="@color/black_solid"
                android:id="@+id/tv_act_periksa_toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tindakan_periksa"
                android:layout_centerInParent="true"
                style="@style/TextAppearance.AppCompat.Widget.ActionBar.Title"
                tools:ignore="RelativeOverlap,VisualLintSystemUi" />
            <ImageView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:src="@drawable/logo_posyandu"
                android:contentDescription="@string/logo"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/act_periksa_swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/act_periksa_toolbar">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:ignore="ScrollViewCount">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_act_periksa"
                        android:paddingBottom="70dp"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        tools:ignore="UselessParent">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:id="@+id/tv_act_periksa_tindakan_title"
                                android:textSize="18sp"
                                android:layout_centerInParent="true"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:ignore="RelativeOverlap" />
                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_act_periksa_tindakan"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_alignParentEnd="true"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/background_button"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:text="@string/tindakan"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                tools:ignore="RelativeOverlap,TouchTargetSizeCheck,TextContrastCheck" />
                        </RelativeLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/ll_act_periksa_data"
                            android:visibility="visible"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginStart="15dp"
                                android:layout_marginEnd="15dp">
                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/nama"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttk_dua"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:id="@+id/tv_act_periksa_nama"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/ll_act_periksa_nama_suami"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginStart="15dp"
                                android:layout_marginEnd="15dp">

                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/nama_suami"
                                    tools:ignore="TextSizeCheck" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttk_dua"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:id="@+id/tv_act_periksa_nama_suami"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/ll_act_periksa_tgl_hamil"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginStart="15dp"
                                android:layout_marginEnd="15dp">

                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/tanggal_hamil"
                                    tools:ignore="TextSizeCheck" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttk_dua"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:id="@+id/tv_act_periksa_tgl_hamil"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/ll_act_periksa_usia_hamil"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginStart="15dp"
                                android:layout_marginEnd="15dp">

                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/usia_hamil"
                                    tools:ignore="TextSizeCheck" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttk_dua"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:id="@+id/tv_act_periksa_usia_hamil"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginStart="15dp"
                                android:layout_marginEnd="15dp">
                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/umur"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttk_dua"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:id="@+id/tv_act_periksa_umur"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/tahun"/>
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/ll_act_periksa_jk"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginStart="15dp"
                                android:layout_marginEnd="15dp">

                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/jenis_kelamin"
                                    tools:ignore="TextSizeCheck" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttk_dua"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:id="@+id/tv_act_periksa_jk"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginStart="15dp"
                                android:layout_marginEnd="15dp">
                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/nik"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttk_dua"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:id="@+id/tv_act_periksa_nik"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginStart="15dp"
                                android:layout_marginEnd="15dp">
                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/no_kk"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttk_dua"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:id="@+id/tv_act_periksa_kk"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginStart="15dp"
                                android:layout_marginEnd="15dp">
                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/no_bpjs"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttk_dua"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:id="@+id/tv_act_periksa_bpjs"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>

                        </LinearLayout>
                        <TextView
                            android:textSize="18sp"
                            android:layout_gravity="center_horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="@string/riwayat"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/ll_act_periksa_riwayat_periksa"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TableLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:stretchColumns="1"
                                android:layout_marginStart="5dp"
                                android:layout_marginEnd="5dp"
                                app:cardCornerRadius="5dp"
                                tools:ignore="UselessParent">
                                <TableRow android:background="#51b435">
                                    <TextView
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/white"
                                        android:padding="5dp"
                                        android:layout_width="90dp"
                                        android:layout_height="wrap_content"
                                        android:text="@string/tanggal"
                                        android:textAlignment="center"
                                        tools:ignore="TooDeepLayout" />
                                    <TextView
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/white"
                                        android:padding="5dp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/pemeriksaan"
                                        android:layout_weight="1"
                                        android:textAlignment="center"/>
                                    <TextView
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/white"
                                        android:padding="5dp"
                                        android:layout_width="65dp"
                                        android:layout_height="wrap_content"
                                        android:text="@string/tinggi"
                                        android:textAlignment="center"/>
                                    <TextView
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/white"
                                        android:padding="5dp"
                                        android:layout_width="65dp"
                                        android:layout_height="wrap_content"
                                        android:text="@string/detail"
                                        android:layout_weight="1"
                                        android:textAlignment="center"/>
                                </TableRow>
                            </TableLayout>
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_act_periksa_riwayat_periksa"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingBottom="10dp"/>
                        </LinearLayout>


                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/ll_act_periksa_history"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginStart="15dp"
                                android:layout_marginEnd="15dp">
                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/tanggal"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttk_dua"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:id="@+id/tv_act_periksa_history_tgl"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginStart="15dp"
                                android:layout_marginEnd="15dp">
                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/item"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttk_dua"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:id="@+id/tv_act_periksa_history_nama"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginStart="15dp"
                                android:layout_marginEnd="15dp">
                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/tinggi"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttk_dua"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:id="@+id/tv_act_periksa_history_tinggi"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/cm"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginStart="15dp"
                                android:layout_marginEnd="15dp">
                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/berat"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttk_dua"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:id="@+id/tv_act_periksa_history_berat"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/kg"
                                    tools:ignore="TooManyViews" />
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginStart="15dp"
                                android:layout_marginEnd="15dp">
                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/tensi"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttk_dua"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:id="@+id/tv_act_periksa_history_tensi"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/mmhg"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginStart="15dp"
                                android:layout_marginEnd="15dp">
                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/hasil"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttk_dua"
                                    android:layout_marginEnd="5dp"
                                    tools:ignore="TooManyViews" />
                                <TextView
                                    android:id="@+id/tv_act_periksa_history_hasil"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:ignore="TooManyViews" />
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginStart="15dp"
                                android:layout_marginEnd="15dp"
                                android:layout_marginBottom="30dp"
                                tools:ignore="TooManyViews">
                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/nama_bidan"
                                    tools:ignore="TooManyViews" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttk_dua"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:id="@+id/tv_act_periksa_history_nama_bidan"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                        </LinearLayout>
                        
                        
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/ll_act_periksa_no_riwayat"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="30dp">
                            <TextView
                                android:textSize="18sp"
                                android:layout_gravity="center_horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tidak_ada_riwayat"/>
                        </LinearLayout>


                    </LinearLayout>

                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_act_periksa_tindakan"
                        android:paddingBottom="70dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        tools:ignore="UselessParent">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:paddingStart="15dp"
                            android:background="@drawable/border_spinner"
                            android:orientation="horizontal"
                            tools:ignore="RtlSymmetry">
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_marginEnd="5dp"
                                android:contentDescription="@string/periksa"
                                android:src="@drawable/ic_baseline_stethoscope_black_24"/>
                            <Spinner
                                android:id="@+id/spinner_act_periksa"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="5dp"/>
                        </LinearLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:hint="@string/masukkan_tinggi_badan"
                            app:startIconDrawable="@drawable/ic_baseline_pin_24"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/eT_act_periksa_tinggi"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerHorizontal="true"
                                android:layout_centerVertical="true"
                                android:ems="10"
                                android:inputType="numberDecimal"
                                android:textColorHint="#757575"
                                tools:ignore="TextContrastCheck,VisualLintTextFieldSize" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:hint="@string/masukkan_berat_badan"
                            app:startIconDrawable="@drawable/ic_baseline_pin_24"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/eT_act_periksa_berat"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerHorizontal="true"
                                android:layout_centerVertical="true"
                                android:ems="10"
                                android:inputType="numberDecimal"
                                android:textColorHint="#757575"
                                tools:ignore="TextContrastCheck,VisualLintTextFieldSize" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:hint="@string/masukkan_tensi_mmhg"
                            app:startIconDrawable="@drawable/ic_baseline_pin_24"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/eT_act_periksa_tensi"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerHorizontal="true"
                                android:layout_centerVertical="true"
                                android:inputType="number|phone"
                                android:digits="0123456789/"
                                android:textColorHint="#757575"
                                tools:ignore="TextContrastCheck,VisualLintTextFieldSize" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:hint="@string/masukkan_hasil_periksa"
                            app:startIconDrawable="@drawable/ic_baseline_comment_24"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/eT_act_periksa_hasil"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerHorizontal="true"
                                android:layout_centerVertical="true"
                                android:ems="10"
                                android:minLines="3"
                                android:inputType="textMultiLine|textCapSentences"
                                android:textColorHint="#757575"
                                tools:ignore="TextContrastCheck,VisualLintTextFieldSize" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:paddingStart="15dp"
                            android:background="@drawable/border_spinner"
                            android:orientation="horizontal"
                            tools:ignore="RtlSymmetry">
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_marginEnd="5dp"
                                android:contentDescription="@string/bidan"
                                android:src="@drawable/ic_baseline_midwife_24"/>
                            <Spinner
                                android:id="@+id/spinner_act_periksa_bidan"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="5dp"/>
                        </LinearLayout>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="30dp">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_act_periksa_batal"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_alignParentStart="true"
                                android:layout_marginStart="10dp"
                                android:background="@drawable/background_button"
                                android:drawableStart="@drawable/ic_baseline_cancel_white_24"
                                android:paddingStart="25dp"
                                android:paddingEnd="25dp"
                                android:text="@string/batal"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                tools:ignore="TextContrastCheck" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_act_periksa_proses"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_alignParentEnd="true"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/background_button"
                                android:drawableStart="@drawable/ic_baseline_check_white_24"
                                android:paddingStart="25dp"
                                android:paddingEnd="25dp"
                                android:text="@string/proses"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                tools:ignore="RelativeOverlap,TextContrastCheck" />
                        </RelativeLayout>
                    </LinearLayout>
                    
                </RelativeLayout>
            </androidx.core.widget.NestedScrollView>
        </RelativeLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</RelativeLayout>