<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_organizer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:stretchColumns="1"
    android:layout_marginStart="5dp"
    android:layout_marginEnd="5dp"
    app:cardCornerRadius="5dp">
    <TableRow tools:ignore="UselessParent">
        <TextView
            android:id="@+id/tv_cl_organizer_antri"
            android:background="@drawable/border_table"
            android:textSize="13sp"
            android:padding="5dp"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            tools:ignore="VisualLintSystemUi" />
        <TextView
            android:id="@+id/tv_cl_organizer_nama"
            android:background="@drawable/border_table"
            android:textSize="13sp"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:ignore="VisualLintSystemUi" />
        <TextView
            android:id="@+id/tv_cl_organizer_status"
            android:background="@drawable/border_table"
            android:textSize="13sp"
            android:padding="5dp"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            tools:ignore="VisualLintSystemUi" />
    </TableRow>
</TableLayout>