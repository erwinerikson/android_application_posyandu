<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.user.UserActivity">
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/user_btn_menu"
        android:background="@drawable/bg_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:menu="@menu/menu_home"
        tools:ignore="VisualLintBottomNav" />
    <RelativeLayout
        android:id="@+id/rl_user_01"
        android:background="@drawable/bg_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            tools:ignore="UselessParent">
            <ImageView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/logo_posyandu"
                android:contentDescription="@string/logo"/>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp">
                <TextView
                    android:textSize="20sp"
                    android:textColor="@color/color_logo"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pos_pelayanan"/>
                <TextView
                    android:textSize="20sp"
                    android:textColor="@color/color_logo"
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terpadu"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_user_01">
        <RelativeLayout
            android:paddingTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_user_01"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/tv_user_ind_nama"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:text="@string/nama"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttk_dua"
                    android:layout_marginEnd="5dp"/>
                <TextView
                    android:id="@+id/tv_user_nama"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_user_02"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_below="@+id/ll_user_01">
                <TextView
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:text="@string/no_wa"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttk_dua"
                    android:layout_marginEnd="5dp"/>
                <TextView
                    android:id="@+id/tv_user_telp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_user_03"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_below="@+id/ll_user_02">
                <TextView
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:text="@string/alamat"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttk_dua"
                    android:layout_marginEnd="5dp"/>
                <TextView
                    android:id="@+id/tv_user_alamat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_user_04"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_below="@+id/ll_user_03">
                <TextView
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:text="@string/status"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttk_dua"
                    android:layout_marginEnd="5dp"/>
                <TextView
                    android:id="@+id/tv_user_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_user_edit_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_below="@+id/ll_user_04"
                android:layout_alignParentEnd="true"
                android:visibility="gone">
                <TextView
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lihat_pengguna"
                    android:layout_marginEnd="5dp"/>
                <ImageButton
                    android:id="@+id/btn_user_edit_user"
                    android:background="@drawable/background_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_baseline_search_white_24"
                    android:contentDescription="@string/edit"/>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/rl_user_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ll_user_edit_user">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_user_lihat_akun"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/background_button"
                    android:drawableStart="@drawable/ic_baseline_person_search_white_24"
                    android:paddingStart="10dp"
                    android:paddingEnd="15dp"
                    android:text="@string/akun_pengguna"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:ignore="TextContrastCheck" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_user_gantipass"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/background_button"
                    android:drawableStart="@drawable/ic_baseline_key_white_24"
                    android:paddingStart="10dp"
                    android:paddingEnd="15dp"
                    android:text="@string/ganti_password"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    tools:ignore="TextContrastCheck" />
            </RelativeLayout>
            <View
                android:id="@+id/v_user_01"
                android:background="#a40404"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="15dp"
                android:layout_below="@+id/rl_user_btn"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_user_logout"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_below="@+id/v_user_01"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="20dp"
                android:background="@drawable/background_button"
                android:drawableStart="@drawable/ic_baseline_logout_white_24"
                android:paddingStart="20dp"
                android:paddingEnd="25dp"
                android:text="@string/logout"
                android:textColor="@color/white"
                android:textSize="11sp"
                tools:ignore="TextContrastCheck" />
            <ImageView
                android:layout_width="180dp"
                android:layout_height="150dp"
                android:layout_marginTop="15dp"
                android:src="@drawable/logo_posyandu"
                android:layout_below="@+id/btn_user_logout"
                android:layout_centerInParent="true"
                android:contentDescription="@string/logo"/>
        </RelativeLayout>
    </ScrollView>
</RelativeLayout>