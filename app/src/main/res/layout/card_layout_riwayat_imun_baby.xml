<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:stretchColumns="1"
    android:layout_marginStart="5dp"
    android:layout_marginEnd="5dp"
    app:cardCornerRadius="5dp">
    <TableRow android:id="@+id/tr_cl_riwayat_imun_baby"
        tools:ignore="UselessParent">
        <TextView
            android:id="@+id/tv_cl_riwayat_imun_baby_tgl"
            android:textSize="13sp"
            android:padding="5dp"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:background="@drawable/border_table"/>
        <TextView
            android:id="@+id/tv_cl_riwayat_imun_baby_nama"
            android:textSize="13sp"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/border_table"/>
        <TextView
            android:id="@+id/tv_cl_riwayat_imun_baby_tinggi"
            android:textSize="13sp"
            android:padding="5dp"
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:background="@drawable/border_table"/>
        <TextView
            android:id="@+id/tv_cl_riwayat_imun_baby_berat"
            android:textSize="13sp"
            android:padding="5dp"
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="center"
            android:background="@drawable/border_table" />
    </TableRow>
</TableLayout>