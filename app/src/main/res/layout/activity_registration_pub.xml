                            android:paddingStart="15dp"
                            tools:ignore="RtlSymmetry">
                            <RadioButton
                                android:id="@+id/rb_daftar_pub_lansia_l"
                                android:layout_width="wrap_content"
                                android:layout_height="35dp"
