                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="25dp"
                    android:layout_marginBottom="120dp"
                    android:text="@string/daftar"
                    android:drawableStart="@drawable/ic_baseline_check_white_24"
                    android:paddingStart="30dp"
                    android:paddingEnd="30dp"
                    android:elevation="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_terdaftar_pub"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/anda_sudah_terdaftar"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp">
                    <TextView
                        android:textSize="16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/id_pendaftaran"
                        android:layout_marginEnd="5dp"/>
                    <TextView
                        android:textSize="16sp"
                        android:id="@+id/tv_pub_daftar_id_pendaftaran"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/layanan_yang_dipilih"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tv_pub_daftar_layanan_bayi"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:text="@string/_bayi"
                            android:layout_marginStart="10dp"/>
                        <TextView
                            android:id="@+id/tv_pub_daftar_layanan_ibu"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:text="@string/_ibu"
                            android:layout_marginStart="10dp"/>
                        <TextView
                            android:id="@+id/tv_pub_daftar_layanan_ibu_hamil"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:text="@string/_ibu_hamil"
                            android:layout_marginStart="10dp"/>
                        <TextView
                            android:id="@+id/tv_pub_daftar_layanan_lansia"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:text="@string/_lansia"
                            android:layout_marginStart="10dp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="vertical"
                    android:background="@drawable/border"
                    android:padding="5dp"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp">
                    <TextView
                        android:textStyle="bold"
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nomor_antrian"/>
                    <TextView
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/tv_pub_daftar_antri"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:layout_width="180dp"
                    android:layout_height="150dp"
                    android:layout_marginTop="5dp"
                    android:src="@drawable/logo_posyandu"
                    android:contentDescription="@string/logo"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_no_layanan_pub"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                tools:ignore="UseCompoundDrawables">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tidak_ada_layanan_hari_ini"/>
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:layout_width="180dp"
                    android:layout_height="150dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/logo_posyandu"
                    android:contentDescription="@string/logo"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_daftar_selesai_pub"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp">
                <TextView
                    android:textSize="16sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/terima_kasih_atas_kunjungan_anda"
                    android:textAlignment="center"/>
                <TextView
                    android:textSize="15sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/silahkan_periksa_di_halaman_jadwal"
                    android:textAlignment="center"/>
                <TextView
                    android:textSize="15sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/untuk_kegiatan_berikutnya"
                    android:textAlignment="center"/>
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:layout_width="180dp"
                    android:layout_height="150dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/logo_posyandu"
                    android:contentDescription="@string/logo"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tv_pub_daftar_stt_bayi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nol"/>
        <TextView
            android:id="@+id/tv_pub_daftar_stt_ibu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nol"/>
        <TextView
            android:id="@+id/tv_pub_daftar_stt_lansia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nol"/>
        <TextView
            android:id="@+id/tv_pub_daftar_ind_bayi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nol"/>
        <TextView
            android:id="@+id/tv_pub_daftar_ind_ibu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nol"/>
        <TextView
            android:id="@+id/tv_pub_daftar_ind_ibu_hamil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nol"/>
        <TextView
            android:id="@+id/tv_pub_daftar_ind_lansia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nol"/>
    </LinearLayout>
</RelativeLayout>