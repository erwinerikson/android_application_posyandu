<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.pregnant.PregnantActionImmunizationActivity">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/ibu_hamil_act_imun_toolbar"
        android:background="@drawable/bg_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="15dp">
            <ImageView
                android:id="@+id/iv_ibu_hamil_act_imun_toolbar_back"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_baseline_arrow_back_24"
                android:layout_centerVertical="true"
                android:contentDescription="@string/photo"
                android:paddingEnd="24dp"
                tools:ignore="RtlSymmetry" />
            <TextView
                android:textSize="18sp"
                android:textColor="@color/black_solid"
                android:id="@+id/tv_ibu_hamil_act_imun_toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tindakan_imunisasi"
                android:layout_centerInParent="true"
                style="@style/TextAppearance.AppCompat.Widget.ActionBar.Title"
                tools:ignore="RelativeOverlap,VisualLintSystemUi" />
            <ImageView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:src="@drawable/logo_posyandu"
                android:contentDescription="@string/logo"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/ibu_hamil_act_imun_swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/ibu_hamil_act_imun_toolbar">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:ignore="ScrollViewCount">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_ibu_hamil_act_imun"
                        android:paddingBottom="70dp"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        tools:ignore="UselessParent">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="18sp"
                                android:layout_centerInParent="true"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/data_ibu_hamil"
                                tools:ignore="RelativeOverlap" />
                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_ibu_hamil_act_imun_tindakan"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_alignParentEnd="true"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/background_button"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:text="@string/tindakan"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                tools:ignore="RelativeOverlap,TouchTargetSizeCheck,TextContrastCheck" />
                        </RelativeLayout>

                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/ll_ibu_hamil_act_imun_data"
                            android:visibility="visible"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginStart="15dp"
                                android:layout_marginEnd="15dp">
                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/nama"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttk_dua"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:id="@+id/tv_ibu_hamil_act_nama"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginStart="15dp"
                                android:layout_marginEnd="15dp">
                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/umur"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttk_dua"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:id="@+id/tv_ibu_hamil_act_umur"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/tahun"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginStart="15dp"
                                android:layout_marginEnd="15dp">

                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/nama_suami"
                                    tools:ignore="TextSizeCheck" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttk_dua"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:id="@+id/tv_ibu_hamil_act_suami"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginStart="15dp"
                                android:layout_marginEnd="15dp">

                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/usia_hamil"
                                    tools:ignore="TextSizeCheck" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttk_dua"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:id="@+id/tv_ibu_hamil_act_usia_hamil"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/ll_ibu_hamil_act_nik"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginStart="15dp"
                                android:layout_marginEnd="15dp">
                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/nik"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttk_dua"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:id="@+id/tv_ibu_hamil_act_nik"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/ll_ibu_hamil_act_kk"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginStart="15dp"
                                android:layout_marginEnd="15dp">
                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/no_kk"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttk_dua"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:id="@+id/tv_ibu_hamil_act_kk"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/ll_ibu_hamil_act_bpjs"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginStart="15dp"
                                android:layout_marginEnd="15dp">
                                <TextView
                                    android:layout_width="93dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/no_bpjs"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttk_dua"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:id="@+id/tv_ibu_hamil_act_bpjs"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:textSize="18sp"
                            android:layout_gravity="center_horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="@string/riwayat"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/ll_ibu_hamil_act_riwayat_imun"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TableLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:stretchColumns="1"
                                android:layout_marginStart="5dp"
                                android:layout_marginEnd="5dp"
                                app:cardCornerRadius="5dp"
                                tools:ignore="UselessParent">
                                <TableRow android:background="#51b435">
                                    <TextView
                                        android:textSize="13sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/white"
                                        android:padding="5dp"
                                        android:layout_width="85dp"
                                        android:layout_height="wrap_content"
                                        android:text="@string/tanggal"
                                        android:textAlignment="center"
                                        tools:ignore="TooDeepLayout" />
                                    <TextView
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/white"
                                        android:padding="5dp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/imunisasi"
                                        android:layout_weight="1"
                                        android:textAlignment="center"/>
                                </TableRow>
                            </TableLayout>
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_ibu_hamil_act_riwayat_imun"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingBottom="10dp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/ll_ibu_hamil_act_no_riwayat"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="30dp">
                            <TextView
                                android:textSize="18sp"
                                android:layout_gravity="center_horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tidak_ada_riwayat"/>
                        </LinearLayout>
                        
                    </LinearLayout>

                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_ibu_hamil_act_imun_tindakan"
                        android:paddingBottom="70dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        tools:ignore="UselessParent">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:paddingStart="15dp"
                            android:background="@drawable/border_spinner"
                            android:orientation="horizontal"
                            tools:ignore="RtlSymmetry">
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_marginEnd="5dp"
                                android:contentDescription="@string/imunisasi"
                                android:src="@drawable/ic_baseline_vaccines_24"/>
                            <Spinner
                                android:id="@+id/spinner_ibu_hamil_act_imun"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="5dp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:paddingStart="15dp"
                            android:background="@drawable/border_spinner"
                            android:orientation="horizontal"
                            tools:ignore="RtlSymmetry">
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_marginEnd="5dp"
                                android:contentDescription="@string/imunisasi"
                                android:src="@drawable/ic_baseline_midwife_24"/>
                            <Spinner
                                android:id="@+id/spinner_ibu_hamil_act_imun_bidan"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="5dp"/>
                        </LinearLayout>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="30dp">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_ibu_hamil_act_imun_batal"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_alignParentStart="true"
                                android:layout_marginStart="10dp"
                                android:background="@drawable/background_button"
                                android:drawableStart="@drawable/ic_baseline_cancel_white_24"
                                android:paddingStart="25dp"
                                android:paddingEnd="25dp"
                                android:text="@string/batal"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                tools:ignore="TextContrastCheck" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_ibu_hamil_act_imun_proses"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_alignParentEnd="true"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/background_button"
                                android:drawableStart="@drawable/ic_baseline_check_white_24"
                                android:paddingStart="25dp"
                                android:paddingEnd="25dp"
                                android:text="@string/proses"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                tools:ignore="RelativeOverlap,TextContrastCheck" />
                        </RelativeLayout>
                    </LinearLayout>
                    
                    
                    
                    
                </RelativeLayout>
            </androidx.core.widget.NestedScrollView>
        </RelativeLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</RelativeLayout>